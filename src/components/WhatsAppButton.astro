---
const message = 'Hola, me gustaría hablar sobre un proyecto con Astodev!';
const whatsappUrl = `https://wa.me/573052550729?text=${encodeURIComponent(message)}`;
---

<a
  class="whatsapp-button"
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escríbenos por WhatsApp (abre en una pestaña nueva)"
>
  <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
    <path d="M20.52 3.48A11.87 11.87 0 0 0 12.05 0C5.47 0 .11 5.35.1 11.94c0 2.1.55 4.16 1.6 5.97L0 24l6.27-1.64a11.93 11.93 0 0 0 5.77 1.47h.01c6.58 0 11.94-5.35 11.95-11.94a11.87 11.87 0 0 0-3.48-8.41ZM12.05 21.8h-.01a9.9 9.9 0 0 1-5.04-1.38l-.36-.21-3.72.98.99-3.63-.24-.37a9.9 9.9 0 0 1-1.52-5.25c0-5.47 4.46-9.93 9.94-9.93a9.87 9.87 0 0 1 7.02 2.91 9.87 9.87 0 0 1 2.91 7.03c0 5.47-4.46 9.93-9.97 9.93Zm5.45-7.43c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.88-.79-1.48-1.77-1.65-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.1 3.2 5.08 4.49.71.31 1.27.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.77-.73 2.02-1.43.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z" />
  </svg>
  <span class="whatsapp-label">WhatsApp</span>
</a>

<style>
  .whatsapp-button {
    position: fixed;
    right: calc(1.5rem + env(safe-area-inset-right, 0px));
    bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));
    z-index: 90;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    min-width: 56px;
    min-height: 56px;
    padding: 0.875rem 1.25rem;
    border-radius: 999px;
    background: var(--signal);
    color: var(--bg);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.25);
    transition: background 0.18s ease;
  }

  .whatsapp-button:hover { background: var(--ink); }

  .whatsapp-button:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
  }

  .whatsapp-button svg { flex-shrink: 0; }

  @media (max-width: 760px) {
    .whatsapp-button {
      right: calc(1rem + env(safe-area-inset-right, 0px));
      bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
      width: 56px;
      height: 56px;
      padding: 0.875rem;
    }

    .whatsapp-label { display: none; }
  }
</style>
