---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer-top">
    <div class="footer-brand">
      <a href="/" class="logo">
        <span class="logo-mark" aria-hidden="true"></span>
        ASTODEV
      </a>
      <p>Software · Automatización · Digital</p>
      <p class="tagline">Tecnología que hace crecer tu negocio.</p>
    </div>

    <div class="footer-col">
      <span class="tag">Servicios</span>
      <a href="/servicios#web">Desarrollo web</a>
      <a href="/servicios#software">Software a medida</a>
      <a href="/servicios#automatizacion">Automatización</a>
      <a href="/servicios#ecommerce">E-commerce</a>
      <a href="/servicios#consultoria">Consultoría</a>
    </div>

    <div class="footer-col">
      <span class="tag">Empresa</span>
      <a href="/nosotros">Nosotros</a>
      <a href="/precios">Precios</a>
      <a href="/partners">Partners</a>
      <a href="/contacto">Contacto</a>
    </div>

    <div class="footer-col">
      <span class="tag">Contacto</span>
      <a href="mailto:hola@astodev.co">hola@astodev.co</a>
      <a href="https://wa.me/573000000000" target="_blank" rel="noopener">WhatsApp</a>
      <span class="loc">Medellín, Colombia</span>
    </div>
  </div>

  <div class="wrap footer-bottom">
    <span>© {year} Astodev. Todos los derechos reservados.</span>
    <span class="footer-note">Consultora tecnológica · Medellín, Colombia</span>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-top: clamp(3rem, 6vw, 4.5rem);
    background: var(--bg-raised);
  }
  .footer-top {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: 2.5rem;
    padding-bottom: 3rem;
  }
  .footer-brand .logo {
    font-family: var(--f-mono);
    font-size: 0.95rem;
    letter-spacing: 0.12em;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .logo-mark {
    width: 9px;
    height: 9px;
    background: var(--signal);
    border-radius: 2px;
    box-shadow: 3px 3px 0 var(--brass);
  }
  .footer-brand p {
    margin-top: 0.9rem;
    color: var(--ink-faint);
    font-family: var(--f-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }
  .footer-brand .tagline {
    margin-top: 0.5rem;
    color: var(--ink-dim);
    font-family: var(--f-display);
    font-size: 1.05rem;
    font-style: italic;
    letter-spacing: normal;
  }
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .footer-col .tag { margin-bottom: 0.25rem; }
  .footer-col a, .footer-col .loc {
    color: var(--ink-dim);
    font-size: 0.92rem;
    transition: color 0.15s ease;
  }
  .footer-col a:hover { color: var(--signal); }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 0;
    border-top: 1px solid var(--line);
    font-size: 0.8rem;
    color: var(--ink-faint);
    font-family: var(--f-mono);
  }

  @media (max-width: 760px) {
    .footer-top { grid-template-columns: 1fr 1fr; }
    .footer-bottom { flex-direction: column; gap: 0.5rem; text-align: center; }
  }
</style>
